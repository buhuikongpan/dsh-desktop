{
  "name": "dsh-desktop-shell",
  "version": "1.1.0",
  "description": "DSH Desktop Shell - A native launcher for the DSH WebUI",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder --win --publish never",
    "build:portable": "electron-builder --win portable --publish never",
    "build:nsis": "electron-builder --win nsis --publish never"
  },
  "author": "DSH",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^26.0.0",
    "sharp": "^0.35.3"
  },
  "build": {
    "appId": "com.dsh.desktop-shell",
    "productName": "DSH Desktop",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "dialog-watcher.js",
      "preload.js",
      "progress-preload.js",
      "icon.png"
    ],
    "win": {
      "icon": "icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico",
      "installerHeaderIcon": "icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DSH Desktop",
      "artifactName": "DSH-Desktop-${version}-${arch}.${ext}",
      "installerLanguages": [
        "zh_CN",
        "en_US"
      ]
    },
    "publish": {
      "provider": "github",
      "owner": "buhuikongpan",
      "repo": "dsh-desktop"
    }
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "electron-winstaller@5.4.0": true
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
